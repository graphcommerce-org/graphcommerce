{
  "name": "13 Random, Fun, and Useless Facts About Socks",
  "parent_id": 167929327942297,
  "group_id": "3b0813ce-0bc3-426c-8482-49ab82806237",
  "alternates": [],
  "created_at": "2026-04-22T13:11:45.091Z",
