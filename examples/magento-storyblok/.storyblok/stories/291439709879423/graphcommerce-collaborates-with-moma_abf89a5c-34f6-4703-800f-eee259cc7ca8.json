{
  "name": "GraphCommerce® collaborates with Moma",
  "parent_id": 167929327942297,
  "group_id": "758644aa-8589-4cc5-82dc-414ed5eff300",
  "alternates": [],
  "created_at": "2026-04-20T12:27:15.104Z",
