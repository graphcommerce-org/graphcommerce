{
  "name": "@graphcommerce/next-config",
  "homepage": "https://www.graphcommerce.org/",
  "repository": "github:graphcommerce-org/graphcommerce",
  "version": "11.0.0-canary.56",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/generated/config.ts",
      "default": "./dist/generated/config.js"
    },
    "./config": {
      "types": "./src/generated/configValues/index.ts",
      "edge-light": "./dist/generated/configValues/index.js",
      "browser": "./dist/generated/configValues/publicOnly/index.js",
      "default": "./dist/generated/configValues/index.js"
    },
    "./loadConfig": {
      "types": "./src/config/loadConfig.ts",
      "default": "./dist/config/loadConfig.js"
    },
    "./findParentPath": {
      "types": "./src/utils/findParentPath.ts",
      "default": "./dist/utils/findParentPath.js"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "src/generated/config.ts"
      ],
      "config": [
        "src/generated/configValues/index.ts"
      ]
    }
  },
  "scripts": {
    "dev": "pkgroll --clean-dist --watch",
    "build": "pkgroll --clean-dist",
    "prepack": "pkgroll --clean-dist"
  },
  "dependencies": {
    "@graphql-codegen/cli": "6.3.1",
    "@swc/core": "1.16.21",
    "@swc/wasm-web": "^1.16.21",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.27",
    "chalk": "^6.0.1",
    "cosmiconfig": "^10.0.1",
    "fast-glob": "^3.3.3",
    "glob": "^14.0.3",
    "graphql": "^16.14.2",
    "import-meta-resolve": "^4.2.0",
    "js-yaml": "^5.5.0",
    "js-yaml-loader": "^1.2.2",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@apollo/client": "*",
    "@graphcommerce/prettier-config-pwa": "^11.0.0-canary.56",
    "@lingui/loader": "*",
    "@lingui/macro": "*",
    "@lingui/react": "*",
    "dotenv": "^18",
    "next": "*",
    "prettier": "^3"
  },
  "prettier": "@graphcommerce/prettier-config-pwa",
  "eslint": {
    "extends": "@graphcommerce/eslint-config-pwa"
  },
  "eslintConfig": {
    "extends": "@graphcommerce/eslint-config-pwa",
    "parserOptions": {
      "project": "./tsconfig.json"
    }
  },
  "devDependencies": {
    "pkgroll": "^2.29.0"
  }
}
